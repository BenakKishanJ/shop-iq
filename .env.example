# --- ShopIQ environment ---
# Copy this to .env and fill in your real values. .env is gitignored.

# OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
# open ai compatible endpoint for openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# default chat model (tool-call reliable; verify slug on openrouter.ai/models)
# free-models router: openrouter routes to the best available free model
OPENROUTER_MODEL=openrouter/free
# embeddings: local via sentence-transformers (hosted free embedding via OpenRouter /embeddings)
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIM=2048

# Postgres (matches our docker container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shopiq
POSTGRES_PASSWORD=shopiq
POSTGRES_DB=shopiq

# Telegram (Day 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=